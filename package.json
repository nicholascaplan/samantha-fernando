    "build:content": "node scripts/build-content.mjs _site",
    "test:unit": "node --test \"unit-tests/*.test.mjs\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.0",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.9.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
